#!/bin/sh
set -eu
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'ungrok needs Python 3.10 or newer on Grok Bot’s computer.' 'Nothing changed. Ask your setup assistant to install Python there, then run this command again.' >&2
  exit 1
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  printf '%s\n' 'ungrok needs Python 3.10 or newer. Nothing changed.' 'Ask your setup assistant to update Python on Grok Bot’s computer without replacing its host runtime.' >&2
  exit 1
fi
exec python3 "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/ungrok.py" "$@"
